# Copy to .env (gitignored) and fill in.
ANTHROPIC_API_KEY=
# Shared secret for /api/extract -- any long random string.
APP_TOKEN=
# Supabase project -> Project Settings -> API. URL looks like https://<ref>.supabase.co
SUPABASE_URL=
# The service_role ("secret") key. Server-side only -- never put it in a web page.
SUPABASE_SERVICE_KEY=
# Optional overrides:
# ROSTER_CSV_PATH=data/vehicle_roster.csv
# MAX_FILES_PER_BATCH=12
# MAX_FILE_BYTES=20971520
# The manager's LINE reminders (plain text push; nothing reads replies). Leave blank to switch them off.
# LINE_CHANNEL_ACCESS_TOKEN=
# OWNER_LINE_USER_ID=
# DISABLE_SCHEDULER=1   (set on a second local copy so two apps do not both send reminders)
